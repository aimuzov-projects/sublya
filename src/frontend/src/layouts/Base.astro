    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Пришли видео в Telegram — получи его с субтитрами, где подсвечено произносимое слово." />
    <meta property="og:image" content={new URL('/media/samara/poster.jpg', Astro.site)} />
    <meta name="theme-color" content="#120a24" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={cyrillic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={latin} as="font" type="font/woff2" crossorigin />
