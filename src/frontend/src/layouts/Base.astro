---
import cyrillic from '../assets/fonts/montserrat-cyrillic.woff2?url'
import latin from '../assets/fonts/montserrat-latin.woff2?url'
import '../styles/base.css'

const title = 'Сабля — субтитры как в тиктоке'
const description =
  'Telegram-бот прожигает в видео субтитры как в тиктоке: на экране пара слов, произносимое подсвечено. Можно подставить свой текст.'
