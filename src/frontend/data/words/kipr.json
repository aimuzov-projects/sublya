[
	{ "text": "Доброе", "start": 0.43, "end": 0.85, "line_end": false },
	{ "text": "утро,", "start": 0.85, "end": 1.13, "line_end": false },
	{ "text": "братишки!", "start": 1.13, "end": 1.71, "line_end": true },
	{ "text": "А", "start": 1.71, "end": 1.85, "line_end": false },
	{ "text": "вы", "start": 1.85, "end": 2.01, "line_end": false },
	{ "text": "уже", "start": 2.01, "end": 2.15, "line_end": false },
	{ "text": "побегали", "start": 2.15, "end": 2.49, "line_end": false },
	{ "text": "сегодня?", "start": 2.49, "end": 3.25, "line_end": true },
	{ "text": "Да-да,", "start": 3.25, "end": 3.77, "line_end": false },
	{ "text": "я", "start": 3.77, "end": 3.83, "line_end": false },
	{ "text": "знаю,", "start": 3.83, "end": 4.13, "line_end": false },
	{ "text": "что", "start": 4.13, "end": 4.21, "line_end": false },
	{ "text": "вы", "start": 4.21, "end": 4.31, "line_end": false },
	{ "text": "скажете:", "start": 4.31, "end": 4.67, "line_end": true },
	{ "text": "от", "start": 4.67, "end": 4.79, "line_end": false },
	{ "text": "себя", "start": 4.79, "end": 4.97, "line_end": false },
	{ "text": "не", "start": 4.97, "end": 5.11, "line_end": false },
	{ "text": "убежишь", "start": 5.11, "end": 5.43, "line_end": false },
	{ "text": "и", "start": 5.43, "end": 5.55, "line_end": false },
	{ "text": "всё", "start": 5.55, "end": 5.63, "line_end": false },
	{ "text": "такое.", "start": 5.63, "end": 6.05, "line_end": true },
	{ "text": "Но", "start": 6.05, "end": 6.21, "line_end": false },
	{ "text": "можно", "start": 6.21, "end": 6.65, "line_end": false },
	{ "text": "убежать", "start": 6.65, "end": 6.95, "line_end": false },
	{ "text": "от", "start": 6.95, "end": 7.09, "line_end": false },
	{ "text": "зимы.", "start": 7.09, "end": 8.25, "line_end": true },
	{ "text": "Глядите,", "start": 8.25, "end": 8.69, "line_end": false },
	{ "text": "глядите.", "start": 8.69, "end": 9.77, "line_end": true },
	{ "text": "И", "start": 9.77, "end": 10.21, "line_end": false },
	{ "text": "вообще-то", "start": 10.21, "end": 10.53, "line_end": false },
	{ "text": "приезжайте", "start": 10.53, "end": 10.89, "line_end": false },
	{ "text": "на", "start": 10.89, "end": 11.01, "line_end": false },
	{ "text": "Кипр,", "start": 11.01, "end": 11.33, "line_end": true },
	{ "text": "тут", "start": 11.33, "end": 11.43, "line_end": false },
	{ "text": "уже", "start": 11.43, "end": 11.61, "line_end": false },
	{ "text": "у", "start": 11.61, "end": 11.73, "line_end": false },
	{ "text": "нас", "start": 11.73, "end": 11.83, "line_end": false },
	{ "text": "не", "start": 11.83, "end": 11.97, "line_end": false },
	{ "text": "так", "start": 11.97, "end": 12.09, "line_end": false },
	{ "text": "жарко", "start": 12.09, "end": 12.43, "line_end": true },
	{ "text": "и", "start": 12.43, "end": 12.87, "line_end": false },
	{ "text": "не", "start": 12.87, "end": 12.97, "line_end": false },
	{ "text": "так", "start": 12.97, "end": 13.13, "line_end": false },
	{ "text": "холодно.", "start": 13.13, "end": 14.25, "line_end": true },
	{ "text": "Буду", "start": 14.25, "end": 14.69, "line_end": false },
	{ "text": "вас", "start": 14.69, "end": 14.83, "line_end": false },
	{ "text": "ждать.", "start": 14.83, "end": 15.47, "line_end": false },
	{ "text": "Чмаф!", "start": 15.47, "end": 16.486, "line_end": true }
]
