---
import Metrika from '@aimuzov-projects/infra-site-kit/metrika.astro'
import MetrikaPixel from '@aimuzov-projects/infra-site-kit/metrika-pixel.astro'
import '@aimuzov-projects/infra-site-kit/base.css'
import cyrillic from '#frontend/assets/fonts/montserrat-cyrillic.woff2?url'
import latin from '#frontend/assets/fonts/montserrat-latin.woff2?url'
import { site } from '#frontend/data/site.ts'
import { pageTitle } from '#frontend/lib/title.ts'
import '#frontend/styles/global.css'

type Props = {
	/** Название страницы, к нему дописывается название сайта. На главной не задаётся. */
	title?: string
	/** `meta description` и `og:description`, по умолчанию `site.description`. */
	description?: string
	/** `false` для служебных страниц вроде 404: без canonical и с запретом индексации. */
	index?: boolean
}

const { title, description = site.description, index = true } = Astro.props
const fullTitle = pageTitle(title)
const canonical = new URL(Astro.url.pathname, Astro.site)
// Ссылкой на главную делятся чаще всего, поэтому в её превью идёт `pitch`.
const ogDescription = title ? description : site.pitch

/** Счётчик Яндекс Метрики. */
const metrikaId = 113179171
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{index ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content="ru_RU" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:image" content={new URL('/media/samara/poster.jpg', Astro.site)} />
		<meta name="theme-color" content="#120a24" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preload" href={cyrillic} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={latin} as="font" type="font/woff2" crossorigin />
		<slot name="head" />
		<Metrika id={metrikaId} />
	</head>
	<body>
		<MetrikaPixel id={metrikaId} />
		<slot />
		<script>
			import { glow } from '#frontend/lib/glow.ts'
			glow()
		</script>
	</body>
</html>
