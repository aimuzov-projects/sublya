---
import cyrillic from '#frontend/assets/fonts/montserrat-cyrillic.woff2?url'
import latin from '#frontend/assets/fonts/montserrat-latin.woff2?url'
import Metrika from '#frontend/components/metrika.astro'
import { site } from '#frontend/data/site.ts'
import { pageTitle } from '#frontend/lib/title.ts'
import '#frontend/styles/global.css'

type Props = {
	/** Page name, the site name gets appended to it. Not set on the home page. */
	title?: string
	/** `meta description` and `og:description`, `site.description` by default. */
	description?: string
	/** `false` for service pages like 404: no canonical and indexing is disallowed. */
	index?: boolean
}

const { title, description = site.description, index = true } = Astro.props
const fullTitle = pageTitle(title)
const canonical = new URL(Astro.url.pathname, Astro.site)
// a link to the home page is shared the most, so its preview gets the pitch
const ogDescription = title ? description : site.pitch
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{index ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content="ru_RU" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:image" content={new URL('/media/samara/poster.jpg', Astro.site)} />
		<meta name="theme-color" content="#120a24" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preload" href={cyrillic} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={latin} as="font" type="font/woff2" crossorigin />
		<slot name="head" />
		<Metrika />
	</head>
	<body>
		<slot />
		<script>
			import { glow } from '#frontend/lib/glow.ts'
			glow()
		</script>
	</body>
</html>
