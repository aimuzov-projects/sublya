---
import NotFound from '@aimuzov-projects/infra-site-kit/not-found.astro'
import Header from '#frontend/components/header.astro'
import Base from '#frontend/layouts/base.astro'
---

<Base title="Страница не найдена" description="Такой страницы на сайте нет." index={false}>
	<Header />
	<main class="missing">
		<!-- В sitemap одна главная, подсказывать нечего. -->
		<NotFound suggest={false} />
	</main>
</Base>

<style>
	.missing {
		/* Тема общей 404 -- от сайтовой кнопки `.btn`. */
		--not-found-accent: var(--yellow);
		--not-found-muted: var(--muted);
		--not-found-radius: 999px;

		display: grid;
		place-content: center;
		min-height: calc(100svh - 64px);
	}
</style>
