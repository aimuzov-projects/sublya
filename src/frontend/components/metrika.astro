---
// Yandex Metrika. For a site without the counter, remove this component,
// its call in base.astro and the mc.yandex.ru and yastatic.net sources
// from security.csp in astro.config.mjs.
---

{/* On mobile the ~85 KB counter script steals bandwidth from fonts and the first photo,
    so it loads on first interaction or 4 s after load, earlier ym calls are queued.
    Webvisor is off: on mobile it noticeably raises LCP. The snippet is a file of its own:
    the hash Astro puts into the CSP for an inline script doesn't match its body, and the
    browser blocks it. */}
<script is:inline src="/metrika.js"></script>
<noscript>
	<div>
		<img src="https://mc.yandex.ru/watch/113179171" style="position:absolute; left:-9999px;" alt="" />
	</div>
</noscript>
