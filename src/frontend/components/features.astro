---
import { site } from '#frontend/data/site.ts'
import { typographText } from '#shared/typograph.ts'
import FeatureCard from '#frontend/components/feature-card.svelte'
import '#frontend/styles/features.css'

// the card prints its text word by word itself, past the middleware, so it comes in already set
const cards = [
	{
		title: 'Паузы вместо догадок',
		text: 'Распознавание ошибается на четверть секунды — это заметно. Бот сверяет начало каждого слова с паузами в звуке, и подсветка приходит ровно тогда, когда слово звучит.',
		icon: ['M2 12h2M6 8v8M10 5v14M18 9v6M22 12h-2'],
		dotted: 'M14 10v4',
	},
	{
		title: 'Твой текст, живая речь',
		text: 'Ребёнок проглотил слово, чтец вставил лишнее «и» — не беда. Бот сопоставит услышанное с подписью и оставит на экране правильный текст.',
		icon: ['M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z', 'M14 3v6h6M8 13h8M8 17h5'],
	},
	{
		title: 'Исправления бесплатно',
		text: 'Речь распознаётся один раз. Смена текста или стиля — только перерендер, он занимает секунды.',
		icon: ['M21 12a9 9 0 1 1-2.64-6.36', 'M21 3v6h-6'],
	},
	{
		title: 'Открытый код',
		text: 'Бот написан на TypeScript и ffmpeg, код под MIT. Можно поднять свой на сервере за пару команд.',
		icon: ['m16 18 6-6-6-6M8 6l-6 6 6 6'],
		repos: true,
	},
].map((card) => ({ ...card, title: typographText(card.title), text: typographText(card.text) }))
---

<section class="features">
	<h2>Почему попадает в слова</h2>
	<div class="cards">
		{cards.map(({ repos, ...card }) => (
			<FeatureCard client:visible {...card}>
				{repos && (
					<p class="repo-links">
						<a href={site.repo}>код на GitHub</a>
					</p>
				)}
			</FeatureCard>
		))}
	</div>
</section>
