{
	"useTabs": true,
	"semi": false,
	"singleQuote": true,
	"trailingComma": "all",
	"plugins": ["prettier-plugin-astro"],
	"overrides": [
		{
			"files": "*.astro",
			"options": {
				"parser": "astro"
			}
		},
		{
			"files": ["*.ts", "*.mjs", "*.js"],
			"options": {
				"plugins": ["@ianvs/prettier-plugin-sort-imports"],
				"importOrder": ["<BUILTIN_MODULES>", "<THIRD_PARTY_MODULES>", "", "^#", "", "^[.]"]
			}
		}
	]
}
