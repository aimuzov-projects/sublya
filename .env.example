BOT_TOKEN=
# my.telegram.org, для локального сервера Bot API
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# любой OpenAI-совместимый эндпоинт audio/transcriptions, по умолчанию OpenRouter
STT_API_KEY=
STT_API_URL=https://openrouter.ai/api/v1
STT_MODEL=openai/whisper-large-v3-turbo
# насколько поздно распознаватель ставит начала слов, в секундах;
# пусто -- подобранное значение по умолчанию
STT_LAG=
STT_DAILY_MINUTES=300
# язык для тех, кто ни разу не запускал /lang; пусто -- автоопределение,
# а оно путает русский с английским
DEFAULT_LANG=ru

ADMIN_IDS=
# форум-группа, где бот админ: на каждого пользователя свой топик,
# ответы в нём уходят пользователю
SUPPORT_CHAT_ID=
# админская Mini App для ADMIN_IDS: её публичный адрес, пусто -- выключена
ADMIN_URL=
ADMIN_PORT=8090
DAILY_VIDEOS=10
BONUS_VIDEOS=10
